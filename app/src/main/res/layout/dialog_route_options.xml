<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="出行方式" android:textColor="@color/text" android:textStyle="bold" />
        <Spinner android:id="@+id/spProfile" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="速度（m/s）" android:textColor="@color/text" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/etSpeed" style="@style/Field" android:hint="0–138.89 m/s" android:inputType="numberDecimal" />
        <TextView android:id="@+id/tvPace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="配速：—" android:textColor="@color/sub" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="速度随机幅度（0–50%）" android:textColor="@color/text" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/etSpeedRandom" style="@style/Field" android:hint="随机幅度 %" android:inputType="numberDecimal" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0% 为匀速；非 0% 时速度连续线性变化，各公里配速自然浮动。" android:textColor="@color/sub" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="步频模拟" android:textColor="@color/text" android:textStyle="bold" android:layout_marginTop="18dp" />
        <RadioGroup android:id="@+id/rgCadence" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/rbCadenceOff" android:layout_width="match_parent" android:layout_height="48dp" android:text="关闭" />
            <RadioButton android:id="@+id/rbCadenceAuto" android:layout_width="match_parent" android:layout_height="48dp" android:text="跟随速度" />
            <RadioButton android:id="@+id/rbCadenceCustom" android:layout_width="match_parent" android:layout_height="48dp" android:text="自定义步频" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自定义步频（步 / 分钟，0–240）" android:textColor="@color/sub" android:textSize="12sp" />
        <EditText android:id="@+id/etCadence" style="@style/Field" android:hint="步数 / 分钟" android:inputType="numberDecimal" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="步频随目标值平滑变化。" android:textColor="@color/sub" android:textSize="12sp" />
        <Switch android:id="@+id/swLoop" android:layout_width="match_parent" android:layout_height="48dp" android:text="循环路线" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="循环时终点会回到起点，连续循环请绘制闭合路线。" android:textColor="@color/sub" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
